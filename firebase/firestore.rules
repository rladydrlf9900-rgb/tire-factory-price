rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* 가격표와 안내값은 누구나 읽을 수 있다 — 손님 화면이 읽어야 하므로 */
    match /meta/{doc}   { allow read: if true;  allow write: if request.auth != null; }
    match /prices/{doc} { allow read: if true;  allow write: if request.auth != null; }

    /* 올린 기록은 관리자만 — 파일 이름·백업이 들어 있다 */
    match /uploads/{doc} { allow read, write: if request.auth != null; }

    /* 그 밖은 모두 막는다 */
    match /{document=**} { allow read, write: if false; }
  }
}

{
  "hosting": [
    {
      "site": "tireprice",
      "public": "옮김",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "regex": "^/sizes(?:/.*)?$",
          "destination": "https://tireprice.gilpos.kr/",
          "type": 301
        },
        {
          "regex": "^/(?P<size>[0-9]{3}-[0-9]{2}(?:-[0-9]{2})?|[0-9]{2}X[0-9]{1,2}\\.[0-9]{2}-[0-9]{2})/?$",
          "destination": "https://tireprice.gilpos.kr/?q=:size",
          "type": 301
        },
        {
          "source": "/",
          "destination": "https://tireprice.gilpos.kr/",
          "type": 301
        },
        {
          "source": "/:rest*",
          "destination": "https://tireprice.gilpos.kr/:rest*",
          "type": 301
        }
      ]
    },
    {
      "site": "tireprice-g",
      "public": "옮김",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "regex": "^/sizes(?:/.*)?$",
          "destination": "https://tireprice.gilpos.kr/",
          "type": 301
        },
        {
          "regex": "^/(?P<size>[0-9]{3}-[0-9]{2}(?:-[0-9]{2})?|[0-9]{2}X[0-9]{1,2}\\.[0-9]{2}-[0-9]{2})/?$",
          "destination": "https://tireprice.gilpos.kr/?q=:size",
          "type": 301
        },
        {
          "source": "/",
          "destination": "https://tireprice.gilpos.kr/",
          "type": 301
        },
        {
          "source": "/:rest*",
          "destination": "https://tireprice.gilpos.kr/:rest*",
          "type": 301
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}

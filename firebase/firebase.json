{
  "hosting": [
    {
      "site": "tireprice",
      "public": "옮김",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "https://tireprice.gilpos.kr/",
          "type": 301
        },
        {
          "source": "/:rest*",
          "destination": "https://tireprice.gilpos.kr/:rest*",
          "type": 301
        }
      ]
    },
    {
      "site": "tireprice-g",
      "public": "옮김",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "https://tireprice.gilpos.kr/",
          "type": 301
        },
        {
          "source": "/:rest*",
          "destination": "https://tireprice.gilpos.kr/:rest*",
          "type": 301
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
